{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gesell-control",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "gesell", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "202701", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "202702", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
